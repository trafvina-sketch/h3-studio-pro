{
  "name": "h3-studio-pro",
  "productName": "H3 Studio Pro",
  "version": "3.5.0",
  "description": "H3 Studio Pro - AI Video Generator Desktop App",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win",
    "build:portable": "electron-builder --win portable"
  },
  "author": "H3 Studio Pro",
  "license": "MIT",
  "devDependencies": {
    "electron": "^29.1.5",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.gencpu.h3studiopro",
    "productName": "H3 Studio Pro",
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "../dashboard.py",
        "to": "app-backend/dashboard.py"
      },
      {
        "from": "../scripts",
        "to": "app-backend/scripts",
        "filter": ["**/*", "!__pycache__/**"]
      },
      {
        "from": "../assets",
        "to": "app-backend/assets"
      }
    ],
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "H3 Studio Pro.exe"
    }
  }
}
