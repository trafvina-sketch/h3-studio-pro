{
  "name": "h3-studio-pro",
  "productName": "H3 Studio Pro",
  "version": "3.5.0",
  "description": "H3 Studio Pro - AI Video Generator Desktop App by Duong Tho",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis",
    "build:setup": "electron-builder --win nsis",
    "build:portable": "electron-builder --win portable"
  },
  "author": "Duong Tho (Zalo: 0934415387 | genpixo.com | gencpu.com)",
  "license": "MIT",
  "devDependencies": {
    "electron": "^29.1.5",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.gencpu.h3studiopro",
    "productName": "H3 Studio Pro",
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "../dashboard.py",
        "to": "app-backend/dashboard.py"
      },
      {
        "from": "../scripts",
        "to": "app-backend/scripts",
        "filter": ["**/*", "!__pycache__/**"]
      },
      {
        "from": "../assets",
        "to": "app-backend/assets"
      },
      {
        "from": "../ffmpeg.exe",
        "to": "app-backend/ffmpeg.exe"
      },
      {
        "from": "../python-embed",
        "to": "app-backend/python-embed",
        "filter": ["**/*", "!**/__pycache__/**", "!**/*.pyc"]
      }
    ],
    "win": {
      "icon": "icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "H3 Studio Pro Setup.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "H3 Studio Pro",
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "installerHeaderIcon": "icon.ico",
      "runAfterFinish": true
    }
  }
}
